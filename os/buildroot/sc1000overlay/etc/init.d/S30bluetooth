#! /bin/sh
# Init script to start Bluetooth daemon (BlueZ 5)
# DBUS is started automatically by Buildroot before this script (S01-S29)
# BlueZ-ALSA requires bluetoothd to be running via D-Bus

case "$1" in
	start|"")
		if [ "$VERBOSE" != no ]
		then
			printf "Starting Bluetooth daemon... "
		fi
		
		# Start bluetoothd daemon using full path
		# bluetoothd is located in /usr/libexec/bluetooth/ which is not in PATH
		/usr/libexec/bluetooth/bluetoothd &
		
		# Wait for bluetoothd to initialize and register with D-Bus
		# This is important for BlueZ-ALSA which connects via D-Bus
		sleep 2
		
		# Verify bluetoothd is running
		# Use pidof instead of pgrep (pgrep is not available in minimal buildroot)
		if ! pidof bluetoothd > /dev/null 2>&1; then
			echo "Warning: bluetoothd failed to start" >&2
		fi
		
		# Note: In BlueZ 5, bluetoothd automatically enables the adapter
		# when it starts, so hciconfig is not needed
		# If manual control is needed, use D-Bus commands or btmgmt/bluetoothctl
		
		[ "$VERBOSE" != no ] && echo "done."
		;;
	stop)
		# Stop bluetoothd
		# Use pidof instead of pgrep (pgrep is not available in minimal buildroot)
		if pidof bluetoothd > /dev/null 2>&1; then
			killall bluetoothd
		fi
		;;
	*)
		echo "Usage: bluetooth {start|stop}" >&2
		exit 1
		;;
esac

