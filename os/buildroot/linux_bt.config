# Bluetooth kernel support for SC1000
# This fragment enables Bluetooth support in the Linux kernel for USB Bluetooth dongles
# SC1000 uses USB Bluetooth dongles (A13 SoM has no built-in Bluetooth)
# Required for BlueZ and BlueZ-ALSA to work
#
# What is a kernel config fragment?
# - Buildroot applies this file on top of the default kernel config (sunxi defconfig)
# - This allows adding Bluetooth support without modifying the base config
# - The fragment is merged during kernel build: base config + this fragment = final config

# Core Bluetooth subsystem
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y

# Bluetooth USB transport (for USB Bluetooth dongles)
# This is the main driver needed for USB Bluetooth adapters
CONFIG_BT_HCIBTUSB=y
# Support for common USB Bluetooth chip vendors
CONFIG_BT_HCIBTUSB_BCM=y
CONFIG_BT_HCIBTUSB_RTL=y
CONFIG_BT_HCIBTUSB_MTK=y
CONFIG_BT_HCIBTUSB_ATH3K=y

# Bluetooth protocols (needed for audio and general functionality)
CONFIG_BT_RFCOMM=y
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=y
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y
CONFIG_BT_HIDP=y
CONFIG_BT_HS=y
CONFIG_BT_6LOWPAN=y

# Bluetooth features
CONFIG_BT_LEDS=y
CONFIG_BT_MSFTEXT=y
CONFIG_BT_AOSPEXT=y
CONFIG_BT_DEBUGFS=y

